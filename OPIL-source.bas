intro:
CLS:WAIT 2000 MS:c=0
RANDOMIZE TIMER 
'sc=0						:REM debug scene set to cutcene ?? start scene?

POKE 1260,$c5:POKE 1261,$c8:POKE 1262,$ca:POKE 1263,$ca	:REM fued
POKE 1264,$ce:POKE 1265,$80:POKE 1266,$ce:POKE 1267,$c2
POKE 1292,$c5:POKE 1293,$c8:POKE 1294,$cb:POKE 1295,$ca
POKE 1296,$cf:POKE 1297,$c2:POKE 1298,$cb:POKE 1299,$c8
WAIT 3200 MS
CLS:WAIT 2000 MS

FOR x=1152 TO 1408:POKE x,ugb(x-1152):NEXT				:REM ugBasic
WAIT 3200 MS
CLS:WAIT 2000 MS

z=0
FOR y=0 TO 6											:REM title
	FOR x=0 TO 13
		POKE 1193+x+y*32,til(z)
		INC z
	NEXT
NEXT
WAIT 4000 MS
CLS:WAIT 3000 MS

REM --- MAIN LOOP ---------------------------------------------------------------------------
DO
REM --- SCENE CONTROL
IF sc=0 THEN:								:REM CUTSCENES
	GOSUB cutscene
	sc=RND(2)+1				:REM dialog / object
ENDIF

IF sc=1 THEN:								:REM DIALOGS
	GOSUB dialog					
	sc=RND(5)				:REM cutscene / dialog / object
	IF sc>=3 THEN sc=0		:REM pref cut
ENDIF

IF sc=2 THEN:								:REM OBJECTS
	GOSUB object
	sc=RND(5)				:REM cutscene / dialog
	IF sc>=1 THEN sc=1		:REM pref dialog
ENDIF

INC c
IF c=10 THEN GOTO intro

LOOP




REM --- OBJECTS- ----------------------------------------------------------------------------
object:
z=RND(2)

REM --- BRIEFCASE
IF z=0 THEN:
	sc=RND(2)
	IF sc=0 THEN:
		EMPTYTILE=175
		CLS:WAIT 75 MILLISECONDS
		EMPTYTILE=223
		CLS:WAIT 75 MILLISECONDS		
		EMPTYTILE=207
		CLS:WAIT 400 MILLISECONDS		
		EMPTYTILE=128
		CLS		
	ENDIF
	x=0:y=5:z=0
	DO												:REM DRAW CLOSED SUITCASE
		POKE 1024+x+(y+1)*32,suitA(x+z*32)
		INC x:IF x=32 THEN:x=0:INC y:INC z:ENDIF
		EXIT IF y=14		
	LOOP
	IF sc=1 THEN:
		WAIT 1000 MILLISECONDS
		x=0:y=0:z=0
		DO											:REM DRAW OPEN SUITCASE
			POKE 1033+x+(y+1)*32,suitB(x+z*14)
			INC x:IF x=14 THEN:x=0:INC y:INC z:ENDIF
			EXIT IF y=12		
		LOOP
		WAIT 1000 MILLISECONDS
	ENDIF
	WAIT 2000 MILLISECONDS:CLS
ENDIF

REM --- SAFE
IF z=1 THEN:
	x=0:y=0
	DO													:REM LIGHTS DOWN
		DO
			POKE 1057+x+y*32,safe(x+(y+1)*19)			:REM DRAW SAFE
			IF y>8 THEN POKE 1057+x+(y-11)*32,safe(x)	:REM DRAW DARK
			INC x
			EXIT IF x=19
		LOOP
		WAIT 30 MS
		x=0:INC y
		EXIT IF y=14
	LOOP
	x=0:y=13:WAIT 200 MS
	DO													:REM LIGHTS UP
		DO
			POKE 1057+x+y*32,safe(x)					:REM DRAW DARK
			POKE 1057+x+(y-11)*32,safe(x+19)			:REM DRAW SAFE
			INC x
			EXIT IF x=19
		LOOP
		WAIT 60 MS
		x=0:DEC y
		EXIT IF y=10
	LOOP	
	x=0:y=11:WAIT 200 MS
	DO													:REM LIGHTS DOWN
		DO
			POKE 1057+x+y*32,safe(x+(y+1)*19)			:REM DRAW SAFE
			POKE 1057+x+(y-11)*32,safe(x)				:REM DRAW DARK
			INC x
			EXIT IF x=19
		LOOP
		WAIT 80 MS
		x=0:INC y
		EXIT IF y=14
	LOOP
	WAIT 2000 MILLISECONDS:CLS
ENDIF










RETURN

REM --- CUTSCENE ----------------------------------------------------------------------------
cutscene:
z=0 :'z=RND(3)				:REM BKG SCENE TYPE CHOOSER

REM --- SKYLINE
IF z=0 THEN:
	sc=RND(4)													:REM SKYLINE CHOOSER
	z=RND(15)													:REM STILL/SCROLL CHOOSER
	IF z<10 THEN:
		z=16
	ELSE:														:REM SCROLL DIRECTION
		z=RND(2)
		IF z=1 THEN z=32
	ENDIF
	x=0:y=0		
	DO															:REM DRAW BACKGROUND STILL
		IF sc=0 THEN POKE 1024+x+(y+1)*32,midl(x+z+y*64)
		IF sc=1 THEN POKE 1024+x+(y+1)*32,dock(x+z+y*64)
		IF sc=2 THEN POKE 1024+x+(y+1)*32,citi(x+z+y*64)
		IF sc=3 THEN POKE 1024+x+(y+1)*32,spac(x+z+y*64)
		INC x:IF x=32 THEN:x=0:INC y:ENDIF
		EXIT IF y=14
	LOOP
	IF z=16 AND sc=0 THEN:										:REM LIGHT ON?
		x=RND(2):IF x=1 THEN:
			POKE 1351,148:POKE 1352,156:POKE 1353,148:POKE 1354,156
		ENDIF
	ENDIF 
	WAIT #1000 MILLISECONDS
	IF z=0 THEN: 												:REM SCROLL LEFT
		x=33:y=0
		DO
			HSCROLL SCREEN LEFT
			DO
				IF sc=0 THEN POKE 1055+(y+1)*32,midl(x+y*64)	:REM DRAW BACKGROUND
				IF sc=1 THEN POKE 1055+(y+1)*32,dock(x+y*64)
				IF sc=2 THEN POKE 1055+(y+1)*32,citi(x+y*64)
				IF sc=3 THEN POKE 1055+(y+1)*32,spac(x+y*64)
				POKE 1024+(y+1)*32,128
				INC y:EXIT IF y=14
			LOOP
			WAIT #50 MILLISECONDS	
			INC x:y=0:EXIT IF x=64
		LOOP
		WAIT #2500 MILLISECONDS
	ENDIF
	IF z=32 THEN: 												:REM SCROLL RIGHT
		x=32:y=0
		DO
			HSCROLL SCREEN RIGHT
			DO								:REM VERT STRIP
				IF sc=0 THEN POKE 1025+(y+1)*32,midl(x+y*64)	:REM DRAW BACKGROUND
				IF sc=1 THEN POKE 1025+(y+1)*32,dock(x+y*64)
				IF sc=2 THEN POKE 1025+(y+1)*32,citi(x+y*64)
				IF sc=3 THEN POKE 1025+(y+1)*32,spac(x+y*64)
				POKE 1024+(y+1)*32,128
				INC y: EXIT IF y=14
			LOOP
			WAIT #50 MILLISECONDS
			DEC x:y=0:EXIT IF x=0
		LOOP
		WAIT #2500 MILLISECONDS
	ENDIF
	IF z=16 THEN:	
		IF sc=0 THEN:											:REM LIGHTS ON?
			x=RND(2):IF x=1 THEN:
				POKE 1351,148:POKE 1352,156:POKE 1353,148:POKE 1354,156
			ENDIF
		ENDIF
		WAIT #2500 MILLISECONDS
	ENDIF
ENDIF









CLS
RETURN


